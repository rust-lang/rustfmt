// Config docs: <https://docs.renovatebot.com/configuration-options/>
// Shared rust-lang presets: <https://github.com/rust-lang/renovate>
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>rust-lang/renovate:actions",
    "github>rust-lang/renovate:lockfile"
  ],
  "enabledManagers": [
    "cargo",
    "github-actions"
  ],
  // NB: `registry.global-min-publish-age` needs cargo >= 1.100 as
  // `min-publish-age` is only stabilized then. Note that this takes precedence
  // over the nightly in `rust-toolchain.toml`.
  "constraints": {
    "rust": ">=1.100.0"
  },
  "packageRules": [
    {
      // Note that dep bumps can cause subtle formatting changes that can go
      // undetected by the existing test suites.
      "matchManagers": ["cargo"],
      "extends": ["schedule:weekly"],
      // Do not pick up very new artifacts to reduce likelihood of fresh supply
      // chain compromises. NB: this only affects PRs for breaking bumps; see
      // `registry.global-min-publish-age` in `.cargo/config.toml` for lockfile
      // updates.
      "minimumReleaseAge": "7 days"
    }
  ]
}
